rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ADMIN ────────────────────────────────────────────────────────────────
    // Admin is recognised by the OWNER EMAIL (survives account recreation —
    // this was the cause of "permission-denied" in the admin panel) or the
    // pinned owner UID as fallback.
    //
    // ⚠️ IMPORTANT — PUBLISH THESE RULES:
    // Firebase console → Firestore Database → Rules → paste this file → Publish.
    // The game cannot publish rules from the client; until you publish, the
    // old (possibly UID-only) rules stay live and the panel keeps failing.
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@kayracing.com' ||
        request.auth.uid == 'KXVphmcLTng1HaOXwlI0YZmmqll1'
      );
    }
    // Players are signed in by the game (email / Google / anonymous).
    function signedIn() { return request.auth != null; }

    // Cloud profiles, keyed by driver name (A-Z 0-9 _ -, max 12 chars).
    // Any signed-in player may READ (leaderboards / admin panel need it);
    // writes are validated or admin-only.
    match /players/{name} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn()
        && name.matches('^[A-Z0-9_-]{1,12}$')
        && request.resource.data.get('name', name) == name
        && request.resource.data.get('money', 0) is number
        && request.resource.data.get('money', 0) >= 0
        && request.resource.data.get('money', 0) <= 50000000
        && request.resource.data.get('owned', []) is list
        && request.resource.data.get('owned', []).size() <= 20
      );
      allow delete: if isAdmin();
    }

    // Leaderboards: one document per board, at most 20 entries.
    match /boards/{cat} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (
        signedIn()
        && request.resource.data.get('entries', []) is list
        && request.resource.data.get('entries', []).size() <= 20
      );
      allow delete: if isAdmin();
    }

    // Ghost runs: anyone signed in can add one (size-limited).
    match /ghosts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[A-Z0-9_-]{1,12}$')
        && request.resource.data.flat is list
        && request.resource.data.flat.size() <= 20000;
      allow update, delete: if isAdmin();
    }

    // Admin cash-grant log: owner only.
    match /grants/{id} {
      allow read, write: if isAdmin();
    }

    // ── MULTIPLAYER ROOMS (live lobby + ghost-sync racing) ───────────────────
    // rooms/{CODE}        → lobby settings + status (lobby / racing / finished)
    // rooms/{CODE}/p/uid  → per-player live state (pos, lap, progress, finish)
    match /rooms/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{5}$')
        && request.resource.data.status == 'lobby';
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.host == request.auth.uid);

      match /p/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
      }
    }
  }
}
